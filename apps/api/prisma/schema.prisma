  featureWeights           Json                                @map("feature_weights") @db.JsonB
  metrics                  Json                                @db.JsonB
  activationStatus         RecommendationModelActivationStatus @default(CANDIDATE) @map("activation_status")
  trainedAt                DateTime                            @map("trained_at") @db.Timestamptz(3)
  activatedAt              DateTime?                           @map("activated_at") @db.Timestamptz(3)
  createdAt                DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

