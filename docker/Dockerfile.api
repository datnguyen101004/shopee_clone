# syntax=docker/dockerfile:1

# Stage 1: Base image
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
RUN apk add --no-cache libc6-compat openssl

# Stage 2: Dependencies & Builder
FROM base AS builder
WORKDIR /app

# Copy root manifests and workspace configuration for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui/package.json ./packages/ui/
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY packages ./packages
COPY apps/api ./apps/api

# Build shared contracts, generate Prisma client, and build NestJS API
RUN pnpm --filter @shopee-clone/contracts build
RUN pnpm --filter @shopee-clone/api db:generate
RUN pnpm --filter @shopee-clone/api build

# Deploy self-contained production bundle for api
RUN pnpm --filter @shopee-clone/api --prod --legacy deploy /app/deploy && \
    cp -r apps/api/dist /app/deploy/dist && \
    cp -r apps/api/prisma /app/deploy/prisma && \
    cp -r apps/api/src/generated /app/deploy/src/generated && \
    cp pnpm-workspace.yaml /app/deploy/pnpm-workspace.yaml

# Optional production migration image. This deliberately keeps the builder's
# Prisma CLI and source-side Prisma config, while the API runtime stays lean.
FROM builder AS migrator
WORKDIR /app
USER node
CMD ["pnpm", "--filter", "@shopee-clone/api", "db:migrate:deploy"]

# Stage 3: Runtime
FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

# Run as built-in non-root node user
USER node

# Copy deployed self-contained application
COPY --from=builder --chown=node:node /app/deploy ./

EXPOSE 3001

CMD ["node", "dist/main.js"]
