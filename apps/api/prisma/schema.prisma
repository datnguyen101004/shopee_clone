  fulfillment    SellerOrderFulfillment      @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  actorUser      User?                       @relation("SellerOrderFulfillmentActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([orderId, fulfillmentVersion])
  @@unique([orderId, idempotencyKey])
  @@index([orderId, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
  @@map("seller_order_fulfillment_events")
}

model SellerOrderShipment {
  id                String                         @id @default(uuid()) @db.Uuid
  orderId           String                         @unique @map("order_id") @db.Uuid
  provider          SellerOrderShipmentProvider
  trackingCode      String                         @unique @map("tracking_code") @db.VarChar(80)
  status            SellerOrderShipmentStatus      @default(HANDED_OFF)
  service           String                         @db.VarChar(40)
  shippingSnapshot  Json                           @map("shipping_snapshot") @db.JsonB
  handedOffAt       DateTime                       @map("handed_off_at") @db.Timestamptz(3)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             ShopOrder                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            SellerOrderShipmentEvent[]

  @@index([status, handedOffAt(sort: Desc), id])
  @@map("seller_order_shipments")
}

model SellerOrderShipmentEvent {
  id          String                @id @default(uuid()) @db.Uuid
  shipmentId  String                @map("shipment_id") @db.Uuid
  status      SellerOrderShipmentStatus
  occurredAt  DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  shipment    SellerOrderShipment   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, occurredAt, id])
  @@map("seller_order_shipment_events")
}

model SellerOrderInventoryCompensation {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  reason      String    @db.VarChar(80)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  order       ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUser   User?     @relation("SellerOrderCompensationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt, id])
  @@map("seller_order_inventory_compensations")
}

model OrderLine {
  id                              String                      @id @default(uuid()) @db.Uuid
  orderId                         String                      @map("order_id") @db.Uuid
  sourceCartLineId                String                      @map("source_cart_line_id") @db.Uuid
  productId                       String                      @map("product_id") @db.Uuid
  variantId                       String                      @map("variant_id") @db.Uuid
  productName                     String                      @map("product_name") @db.VarChar(240)
  productImageUrl                 String?                     @map("product_image_url") @db.Text
  variantName                     String                      @map("variant_name") @db.VarChar(160)
  variantSku                      String                      @map("variant_sku") @db.VarChar(80)
  quantity                        Int
  unitWeightGrams                 Int                         @map("unit_weight_grams")
  shipmentWeightGrams             Int                         @map("shipment_weight_grams")
  listUnitPriceMinor              BigInt                      @map("list_unit_price_minor")
  sellingUnitPriceMinor           BigInt                      @map("selling_unit_price_minor")
  listSubtotalMinor               BigInt                      @map("list_subtotal_minor")
  productDiscountMinor            BigInt                      @map("product_discount_minor")
  merchandiseSubtotalMinor        BigInt                      @map("merchandise_subtotal_minor")
  shopVoucherDiscountMinor        BigInt                      @map("shop_voucher_discount_minor")
  platformVoucherDiscountMinor    BigInt                      @map("platform_voucher_discount_minor")
  merchandiseVoucherDiscountMinor BigInt                      @map("merchandise_voucher_discount_minor")
  payableMerchandiseMinor         BigInt                      @map("payable_merchandise_minor")
  createdAt                       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  order                           ShopOrder                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product                         Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant                         ProductVariant              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  voucherAllocations              PurchaseVoucherAllocation[]
  review                          ProductReview?

  @@unique([orderId, sourceCartLineId])
  @@index([productId, createdAt, id])
  @@index([variantId, createdAt, id])
  @@index([sourceCartLineId])
  @@map("order_lines")
}

model PurchaseVoucher {
  id                       String                      @id @default(uuid()) @db.Uuid
  purchaseId               String                      @map("purchase_id") @db.Uuid
  voucherId                String                      @map("voucher_id") @db.Uuid
  redemptionId             String?                     @unique @map("redemption_id") @db.Uuid
  shopId                   String?                     @map("shop_id") @db.Uuid
  code                     String                      @db.VarChar(32)
  name                     String                      @db.VarChar(160)
  issuer                   VoucherIssuer
  benefitType              VoucherBenefitType          @map("benefit_type")
  slot                     PurchaseVoucherSlot
  merchandiseDiscountMinor BigInt                      @map("merchandise_discount_minor")
  shippingDiscountMinor    BigInt                      @map("shipping_discount_minor")
  discountMinor            BigInt                      @map("discount_minor")
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  purchase                 Purchase                    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  voucher                  Voucher                     @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  redemption               VoucherRedemption?          @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  shop                     Shop?                       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  allocations              PurchaseVoucherAllocation[]

  @@unique([purchaseId, voucherId])
  @@index([voucherId, createdAt, id])
  @@index([shopId, createdAt, id])
  @@map("purchase_vouchers")
}

model PurchaseVoucherAllocation {
  id                String                @id @default(uuid()) @db.Uuid
  purchaseVoucherId String                @map("purchase_voucher_id") @db.Uuid
  shopOrderId       String                @map("shop_order_id") @db.Uuid
  orderLineId       String?               @map("order_line_id") @db.Uuid
  kind              VoucherAllocationKind
  amountMinor       BigInt                @map("amount_minor")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  purchaseVoucher   PurchaseVoucher       @relation(fields: [purchaseVoucherId], references: [id], onDelete: Restrict)
  shopOrder         ShopOrder             @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  orderLine         OrderLine?            @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@index([purchaseVoucherId, shopOrderId, orderLineId])
  @@index([shopOrderId, createdAt, id])
  @@index([orderLineId])
  @@map("purchase_voucher_allocations")
}

model VoucherRedemption {
  id                       String             @id @default(uuid()) @db.Uuid
  consumptionId            String             @map("consumption_id") @db.Uuid
  voucherId                String             @map("voucher_id") @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  merchandiseDiscountMinor BigInt             @map("merchandise_discount_minor")
  shippingDiscountMinor    BigInt             @map("shipping_discount_minor")
  discountMinor            BigInt             @map("discount_minor")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  consumption              VoucherConsumption @relation(fields: [consumptionId], references: [id], onDelete: Restrict)
  voucher                  Voucher            @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchaseVoucher          PurchaseVoucher?

  @@unique([consumptionId, voucherId])
  @@index([voucherId, createdAt, id])
  @@index([userId, createdAt, id])
  @@map("voucher_redemptions")
}

model ProductImage {
  id                      String                   @id @default(uuid()) @db.Uuid
  productId               String                   @map("product_id") @db.Uuid
  variantId               String?                  @map("variant_id") @db.Uuid
  url                     String                   @db.Text
  altText                 String?                  @map("alt_text") @db.VarChar(240)
  sortOrder               Int                      @default(0) @map("sort_order")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant                 ProductVariant?          @relation("VariantGalleryMedia", fields: [productId, variantId], references: [productId, id], onDelete: Restrict)
  sellerProductMediaAsset SellerProductMediaAsset? @relation("SellerProductMediaAssetProductImage")
  productOptionValues     ProductOptionValue[]

  @@unique([productId, sortOrder])
  @@index([productId])
  @@index([productId, variantId])
  @@map("product_images")
}

model SellerProductMediaAsset {
  id             String                  @id @default(uuid()) @db.Uuid
  uploaderId     String                  @map("uploader_id") @db.Uuid
  shopId         String                  @map("shop_id") @db.Uuid
  productId      String?                 @map("product_id") @db.Uuid
  productImageId String?                 @unique @map("product_image_id") @db.Uuid
  storageKey     String                  @unique @map("storage_key") @db.VarChar(255)
  mimeType       String                  @map("mime_type") @db.VarChar(32)
  byteSize       Int                     @map("byte_size")
  width          Int
  height         Int
  state          SellerProductMediaState @default(STAGED)
  expiresAt      DateTime?               @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  uploader       User                    @relation("SellerProductMediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  shop           Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  productImage   ProductImage?           @relation("SellerProductMediaAssetProductImage", fields: [productImageId], references: [id], onDelete: SetNull)

  @@index([uploaderId, state, expiresAt])
  @@index([shopId, productId, state])
  @@index([state, expiresAt])
  @@map("seller_product_media_assets")
}

model Inventory {
  variantId        String                @id @map("variant_id") @db.Uuid
  quantityOnHand   Int                   @default(0) @map("quantity_on_hand")
  quantityReserved Int                   @default(0) @map("quantity_reserved")
  quantitySold     Int                   @default(0) @map("quantity_sold")
  version          Int                   @default(0)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustments      InventoryAdjustment[] @relation("InventoryAdjustmentInventory")

  @@index([updatedAt])
  @@map("inventory")
}

model InventoryAdjustment {
  id                   String                    @id @default(uuid()) @db.Uuid
  variantId            String                    @map("variant_id") @db.Uuid
  shopId               String                    @map("shop_id") @db.Uuid
  actorUserId          String?                   @map("actor_user_id") @db.Uuid
  reason               InventoryAdjustmentReason
  note                 String?                   @db.VarChar(500)
  delta                Int
  quantityOnHandBefore Int                       @map("quantity_on_hand_before")
  quantityOnHandAfter  Int                       @map("quantity_on_hand_after")
  quantityReserved     Int                       @map("quantity_reserved")
  quantitySold         Int                       @map("quantity_sold")
  inventoryVersion     Int                       @map("inventory_version")
  idempotencyKey       String?                   @map("idempotency_key") @db.Uuid
  requestDigest        String?                   @map("request_digest") @db.Char(64)
  sourceOrderId        String?                   @map("source_order_id") @db.Uuid
  occurredAt           DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  inventory            Inventory                 @relation("InventoryAdjustmentInventory", fields: [variantId], references: [variantId], onDelete: Restrict, map: "inventory_adjustments_inventory_variant_id_fkey")
  variant              ProductVariant            @relation("InventoryAdjustmentVariant", fields: [variantId], references: [id], onDelete: Restrict, map: "inventory_adjustments_variant_id_fkey")
  shop                 Shop                      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor                User?                     @relation("InventoryAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  sourceOrder          ShopOrder?                @relation("OrderInventoryCompensationAdjustments", fields: [sourceOrderId], references: [id], onDelete: Restrict)

  @@index([variantId, occurredAt(sort: Desc), id])
  @@index([shopId, occurredAt(sort: Desc), id])
  @@index([idempotencyKey])
  @@index([sourceOrderId, variantId, occurredAt(sort: Desc)])
  @@map("inventory_adjustments")
}

model InventoryReservation {
  id              String                     @id @default(uuid()) @db.Uuid
  buyerId         String                     @map("buyer_id") @db.Uuid
  cartVersion     Int                        @map("cart_version")
  idempotencyKey  String                     @map("idempotency_key") @db.Uuid
  requestDigest   String                     @map("request_digest") @db.Char(64)
  generationToken String                     @unique @map("generation_token") @db.Uuid
  status          InventoryReservationStatus @default(ACTIVE)
  expiresAt       DateTime                   @map("expires_at") @db.Timestamptz(3)
  purchaseId      String?                    @unique @map("purchase_id") @db.Uuid
  terminalReason  String?                    @map("terminal_reason") @db.VarChar(120)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  consumedAt      DateTime?                  @map("consumed_at") @db.Timestamptz(3)
  releasedAt      DateTime?                  @map("released_at") @db.Timestamptz(3)
  buyer           User                       @relation("InventoryReservationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  purchase        Purchase?                  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  lines           InventoryReservationLine[]

  @@index([buyerId, idempotencyKey, status])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model InventoryReservationLine {
  id            String               @id @default(uuid()) @db.Uuid
  reservationId String               @map("reservation_id") @db.Uuid
  variantId     String               @map("variant_id") @db.Uuid
  quantity      Int
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([reservationId, variantId])
  @@index([variantId, createdAt])
  @@map("inventory_reservation_lines")
}

model HomepageModule {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique @db.VarChar(120)
  type        HomepageModuleType
  title       String                   @db.VarChar(160)
  subtitle    String?                  @db.VarChar(240)
  isEnabled   Boolean                  @default(true) @map("is_enabled")
  sortOrder   Int                      @default(0) @map("sort_order")
  activeFrom  DateTime?                @map("active_from") @db.Timestamptz(3)
  activeUntil DateTime?                @map("active_until") @db.Timestamptz(3)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  banners     HomepageBanner[]
  categories  HomepageModuleCategory[]
  products    HomepageModuleProduct[]

  @@index([isEnabled, activeFrom, activeUntil, sortOrder])
  @@map("homepage_modules")
}

model HomepageBanner {
  id              String         @id @default(uuid()) @db.Uuid
  moduleId        String         @map("module_id") @db.Uuid
  eyebrow         String?        @db.VarChar(80)
  title           String         @db.VarChar(160)
  description     String?        @db.VarChar(320)
  imageUrl        String?        @map("image_url") @db.Text
  altText         String?        @map("alt_text") @db.VarChar(240)
  destinationPath String         @map("destination_path") @db.VarChar(500)
  themeKey        String         @default("brand") @map("theme_key") @db.VarChar(40)
  sortOrder       Int            @default(0) @map("sort_order")
  module          HomepageModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sortOrder])
