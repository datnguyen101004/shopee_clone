  storedScriptVersion      Int                                 @map("stored_script_version")
  datasetVersion           String                              @map("dataset_version") @db.VarChar(80)
  randomSeed               Int                                 @map("random_seed")
  trainingSource           String                              @map("training_source") @db.VarChar(80)
