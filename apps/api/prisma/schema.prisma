model ModerationCase {
  id                 String                 @id @default(uuid()) @db.Uuid
  targetType         ReportTargetType       @map("target_type")
  productId          String?                @map("product_id") @db.Uuid
  shopId             String?                @map("shop_id") @db.Uuid
  chatConversationId String?                @map("chat_conversation_id") @db.Uuid
  reportedUserId     String?                @map("reported_user_id") @db.Uuid
  targetSnapshot     Json                   @map("target_snapshot")
  status             ModerationCaseStatus   @default(OPEN)
  reportCount        Int                    @default(1) @map("report_count")
  primaryReason      ReportReasonCode       @map("primary_reason")
  assignedAdminId    String?                @map("assigned_admin_id") @db.Uuid
  currentOutcome     ModerationCaseOutcome? @map("current_outcome")
  version            Int                    @default(0)
  firstReportAt      DateTime               @default(now()) @map("first_report_at") @db.Timestamptz(3)
  lastActivityAt     DateTime               @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  resolvedAt         DateTime?              @map("resolved_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  product            Product?               @relation(fields: [productId], references: [id], onDelete: Restrict)
  shop               Shop?                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  chatConversation   ChatConversation?      @relation(fields: [chatConversationId], references: [id], onDelete: Restrict)
  reportedUser       User?                  @relation("ModerationCaseReportedUser", fields: [reportedUserId], references: [id], onDelete: Restrict)
  assignedAdmin      User?                  @relation("ModerationCaseAssignee", fields: [assignedAdminId], references: [id], onDelete: Restrict)
  reports            UserReport[]
  events             ModerationCaseEvent[]
  decisions          ModerationDecision[]

  @@index([status, lastActivityAt(sort: Desc), id])
  @@index([targetType, lastActivityAt(sort: Desc)])
  @@index([assignedAdminId, status])
  @@index([productId])
  @@index([shopId])
  @@index([chatConversationId, reportedUserId, status])
  @@map("moderation_cases")
}

