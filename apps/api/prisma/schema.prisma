generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("user_status")
}

enum ShopStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("shop_status")
}

enum ProductStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("variant_status")
}

enum HomepageModuleType {
  CAMPAIGN_BANNER       @map("campaign_banner")
  CATEGORY_SHORTCUTS    @map("category_shortcuts")
  FLASH_SALE            @map("flash_sale")
  TOP_SELLING           @map("top_selling")
  MALL                  @map("mall")
  DAILY_RECOMMENDATIONS @map("daily_recommendations")

  @@map("homepage_module_type")
}

enum PasswordResetDeliveryStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")

  @@map("password_reset_delivery_status")
}

enum ExternalIdentityProvider {
  GOOGLE @map("google")

  @@map("external_identity_provider")
}

enum MarketplaceRole {
  BUYER  @map("buyer")
  SELLER @map("seller")
  ADMIN  @map("admin")

  @@map("marketplace_role")
}

enum RoleAuditAction {
  GRANT  @map("grant")
  REVOKE @map("revoke")

  @@map("role_audit_action")
}

enum RoleAuditSource {
  SYSTEM    @map("system")
  MIGRATION @map("migration")
  SEED      @map("seed")
  BOOTSTRAP @map("bootstrap")
  ADMIN     @map("admin")

  @@map("role_audit_source")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  displayName         String               @map("display_name") @db.VarChar(120)
  passwordHash        String?              @map("password_hash") @db.VarChar(255)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  shop                Shop?
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  externalIdentities  ExternalIdentity[]
  roleAssignments     UserRoleAssignment[] @relation("RoleAssignmentTarget")
  rolesGranted        UserRoleAssignment[] @relation("RoleAssignmentActor")
  roleAuditEvents     RoleAuditEvent[]     @relation("RoleAuditTarget")
  roleAuditActions    RoleAuditEvent[]     @relation("RoleAuditActor")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model UserRoleAssignment {
  userId          String          @map("user_id") @db.Uuid
  role            MarketplaceRole
  grantedAt       DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  source          RoleAuditSource
  grantedByUserId String?         @map("granted_by_user_id") @db.Uuid
  user            User            @relation("RoleAssignmentTarget", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy       User?           @relation("RoleAssignmentActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@index([role, userId])
  @@index([grantedByUserId])
  @@map("user_role_assignments")
}

model RoleAuditEvent {
  id           String          @id @default(uuid()) @db.Uuid
  targetUserId String          @map("target_user_id") @db.Uuid
  role         MarketplaceRole
  action       RoleAuditAction
  source       RoleAuditSource
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  reason       String          @db.VarChar(240)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  targetUser   User            @relation("RoleAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUser    User?           @relation("RoleAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([role, action, createdAt])
  @@map("role_audit_events")
}

model ExternalIdentity {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  provider        ExternalIdentityProvider
  providerSubject String                   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt     DateTime                 @default(now()) @map("last_login_at") @db.Timestamptz(3)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([provider, userId])
  @@index([userId])
  @@map("external_identities")
}

model GoogleLoginAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  stateHash          String    @unique @map("state_hash") @db.Char(64)
  browserBindingHash String    @map("browser_binding_hash") @db.Char(64)
  nonceHash          String    @map("nonce_hash") @db.Char(64)
  protectedPayload   String    @map("protected_payload") @db.Text
  returnTo           String    @map("return_to") @db.VarChar(500)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([consumedAt, expiresAt])
  @@map("google_login_attempts")
}

model AuthSession {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  familyId     String       @default(uuid()) @map("family_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)
  rotatedAt    DateTime?    @map("rotated_at") @db.Timestamptz(3)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  replacedById String?      @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(3)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   AuthSession? @relation("AuthSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id             String                      @id @default(uuid()) @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  tokenHash      String                      @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime                    @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?                   @map("used_at") @db.Timestamptz(3)
  revokedAt      DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  deliveryStatus PasswordResetDeliveryStatus @default(PENDING) @map("delivery_status")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Shop {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @unique @map("owner_id") @db.Uuid
  slug      String     @unique @db.VarChar(120)
  name      String     @db.VarChar(160)
  location  String     @default("Việt Nam") @db.VarChar(120)
  status    ShopStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products  Product[]

  @@index([status])
  @@index([deletedAt])
  @@map("shops")
}

model Category {
  id              String                   @id @default(uuid()) @db.Uuid
  parentId        String?                  @map("parent_id") @db.Uuid
  slug            String                   @unique @db.VarChar(120)
  name            String                   @db.VarChar(160)
  sortOrder       Int                      @default(0) @map("sort_order")
  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(3)
  parent          Category?                @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]               @relation("CategoryHierarchy")
  products        Product[]
  homepageEntries HomepageModuleCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id                       String                  @id @default(uuid()) @db.Uuid
  shopId                   String                  @map("shop_id") @db.Uuid
  categoryId               String                  @map("category_id") @db.Uuid
  slug                     String                  @db.VarChar(160)
  name                     String                  @db.VarChar(240)
  description              String                  @db.Text
  status                   ProductStatus           @default(DRAFT)
  ratingAverageBasisPoints Int                     @default(0) @map("rating_average_basis_points")
  ratingCount              Int                     @default(0) @map("rating_count")
  soldCount                Int                     @default(0) @map("sold_count")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?               @map("deleted_at") @db.Timestamptz(3)
  shop                     Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category                 Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants                 ProductVariant[]
  images                   ProductImage[]
  homepageEntries          HomepageModuleProduct[]
  datasetRecord            DatasetProductRecord?

  @@unique([shopId, slug])
  @@index([shopId, status])
  @@index([categoryId, status])
  @@index([status, createdAt, id])
  @@index([deletedAt])
  @@map("products")
}

model DatasetSource {
  id            String                 @id @db.Uuid
  key           String                 @unique @db.VarChar(64)
  fileName      String                 @unique @map("file_name") @db.VarChar(120)
  sourceUrl     String                 @map("source_url") @db.Text
  checksum      String                 @db.Char(64)
  recordCount   Int                    @map("record_count")
  rootMetadata  Json                   @map("root_metadata") @db.JsonB
  policyVersion String                 @map("policy_version") @db.VarChar(40)
  importedAt    DateTime               @map("imported_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  records       DatasetProductRecord[]

  @@index([policyVersion])
  @@map("dataset_sources")
}

model DatasetProductRecord {
  id               String        @id @db.Uuid
  sourceId         String        @map("source_id") @db.Uuid
  productId        String        @unique @map("product_id") @db.Uuid
  stableRecordKey  String        @map("stable_record_key") @db.Char(64)
  sourceIdentity   String        @map("source_identity") @db.Text
  sourceIndex      Int           @map("source_index")
  sourceProductUrl String?       @map("source_product_url") @db.Text
  sourcePageUrl    String?       @map("source_page_url") @db.Text
  rawNotes         String?       @map("raw_notes") @db.Text
  rawPayload       Json          @map("raw_payload") @db.JsonB
  generatedFields  Json          @map("generated_fields") @db.JsonB
  isActive         Boolean       @default(true) @map("is_active")
  normalizedAt     DateTime      @map("normalized_at") @db.Timestamptz(3)
  source           DatasetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sourceId, stableRecordKey])
  @@index([sourceId, isActive, sourceIndex])
  @@map("dataset_product_records")
}

model ProductVariant {
  id                  String         @id @default(uuid()) @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  sku                 String         @unique @db.VarChar(80)
  name                String         @db.VarChar(160)
  priceMinor          BigInt         @map("price_minor")
  compareAtPriceMinor BigInt?        @map("compare_at_price_minor")
  status              VariantStatus  @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(3)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory           Inventory?
  images              ProductImage[] @relation("VariantGalleryMedia")

  @@unique([productId, id])
  @@index([productId, status])
  @@index([deletedAt])
  @@map("product_variants")
}

model ProductImage {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  variantId String?         @map("variant_id") @db.Uuid
  url       String          @db.Text
  altText   String?         @map("alt_text") @db.VarChar(240)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation("VariantGalleryMedia", fields: [productId, variantId], references: [productId, id], onDelete: Restrict)

  @@unique([productId, sortOrder])
  @@index([productId])
  @@index([productId, variantId])
  @@map("product_images")
}

model Inventory {
  variantId        String         @id @map("variant_id") @db.Uuid
  quantityOnHand   Int            @default(0) @map("quantity_on_hand")
  quantityReserved Int            @default(0) @map("quantity_reserved")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("inventory")
}

model HomepageModule {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique @db.VarChar(120)
  type        HomepageModuleType
  title       String                   @db.VarChar(160)
  subtitle    String?                  @db.VarChar(240)
  isEnabled   Boolean                  @default(true) @map("is_enabled")
  sortOrder   Int                      @default(0) @map("sort_order")
  activeFrom  DateTime?                @map("active_from") @db.Timestamptz(3)
  activeUntil DateTime?                @map("active_until") @db.Timestamptz(3)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  banners     HomepageBanner[]
  categories  HomepageModuleCategory[]
  products    HomepageModuleProduct[]

  @@index([isEnabled, activeFrom, activeUntil, sortOrder])
  @@map("homepage_modules")
}

model HomepageBanner {
  id              String         @id @default(uuid()) @db.Uuid
  moduleId        String         @map("module_id") @db.Uuid
  eyebrow         String?        @db.VarChar(80)
  title           String         @db.VarChar(160)
  description     String?        @db.VarChar(320)
  imageUrl        String?        @map("image_url") @db.Text
  altText         String?        @map("alt_text") @db.VarChar(240)
  destinationPath String         @map("destination_path") @db.VarChar(500)
  themeKey        String         @default("brand") @map("theme_key") @db.VarChar(40)
  sortOrder       Int            @default(0) @map("sort_order")
  module          HomepageModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sortOrder])
  @@map("homepage_banners")
}

model HomepageModuleCategory {
  id         String         @id @default(uuid()) @db.Uuid
  moduleId   String         @map("module_id") @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  label      String?        @db.VarChar(160)
  iconKey    String?        @map("icon_key") @db.VarChar(40)
  sortOrder  Int            @default(0) @map("sort_order")
  module     HomepageModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([moduleId, categoryId])
  @@unique([moduleId, sortOrder])
  @@map("homepage_module_categories")
}

model HomepageModuleProduct {
  id        String         @id @default(uuid()) @db.Uuid
  moduleId  String         @map("module_id") @db.Uuid
  productId String         @map("product_id") @db.Uuid
  label     String?        @db.VarChar(120)
  soldCount Int?           @map("sold_count")
  sortOrder Int            @default(0) @map("sort_order")
  module    HomepageModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([moduleId, productId])
  @@unique([moduleId, sortOrder])
  @@map("homepage_module_products")
}
