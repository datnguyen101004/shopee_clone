generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("user_status")
}

enum ShopStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")

  @@map("shop_status")
}

enum ShopOnboardingStatus {
  PENDING_APPROVAL @map("pending_approval")
  APPROVED         @map("approved")
  REJECTED         @map("rejected")

  @@map("shop_onboarding_status")
}

enum ProductStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  HIDDEN   @map("hidden")
  ARCHIVED @map("archived")

  @@map("product_status")
}

enum ProductModerationStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("product_moderation_status")
}

enum VariantStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("variant_status")
}

enum HomepageModuleType {
  CAMPAIGN_BANNER       @map("campaign_banner")
  CATEGORY_SHORTCUTS    @map("category_shortcuts")
  FLASH_SALE            @map("flash_sale")
  TOP_SELLING           @map("top_selling")
  MALL                  @map("mall")
  DAILY_RECOMMENDATIONS @map("daily_recommendations")

  @@map("homepage_module_type")
}

enum PasswordResetDeliveryStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")

  @@map("password_reset_delivery_status")
}

enum ExternalIdentityProvider {
  GOOGLE @map("google")

  @@map("external_identity_provider")
}

enum MarketplaceRole {
  BUYER  @map("buyer")
  SELLER @map("seller")
  ADMIN  @map("admin")

  @@map("marketplace_role")
}

enum RoleAuditAction {
  GRANT  @map("grant")
  REVOKE @map("revoke")

  @@map("role_audit_action")
}

enum RoleAuditSource {
  SYSTEM    @map("system")
  MIGRATION @map("migration")
  SEED      @map("seed")
  BOOTSTRAP @map("bootstrap")
  ADMIN     @map("admin")

  @@map("role_audit_source")
}

enum PrivilegedTargetType {
  USER            @map("user")
  SHOP            @map("shop")
  CATEGORY        @map("category")
  BANNER          @map("banner")
  HOMEPAGE_MODULE @map("homepage_module")
  PRODUCT         @map("product")

  @@map("privileged_target_type")
}


enum PrivilegedAction {
  SUSPEND @map("suspend")
  RESTORE @map("restore")
  CREATE  @map("create")
  UPDATE  @map("update")
  DELETE  @map("delete")
  REORDER @map("reorder")
  APPROVE @map("approve")
  REJECT  @map("reject")

  @@map("privileged_action")
}


enum VoucherIssuer {
  PLATFORM @map("platform")
  SHOP     @map("shop")

  @@map("voucher_issuer")
}

enum VoucherBenefitType {
  FIXED_AMOUNT  @map("fixed_amount")
  PERCENTAGE    @map("percentage")
  FREE_SHIPPING @map("free_shipping")

  @@map("voucher_benefit_type")
}

enum SellerPromotionResource {
  VOUCHER  @map("voucher")
  DISCOUNT @map("discount")

  @@map("seller_promotion_resource")
}

enum PurchasePaymentMethod {
  COD @map("cod")

  @@map("purchase_payment_method")
}

enum PurchasePaymentStatus {
  UNPAID @map("unpaid")

  @@map("purchase_payment_status")
}

enum ShopOrderStatus {
  PENDING_CONFIRMATION @map("pending_confirmation")
  AWAITING_PICKUP      @map("awaiting_pickup")
  SHIPPING             @map("shipping")
  DELIVERED            @map("delivered")
  CANCELLED            @map("cancelled")
  RETURN_REQUESTED     @map("return_requested")
  RETURNED             @map("returned")
  REFUNDED             @map("refunded")

  @@map("shop_order_status")
}

enum OrderTimelineActor {
  SYSTEM @map("system")
  BUYER  @map("buyer")
  SELLER @map("seller")
  ADMIN  @map("admin")

  @@map("order_timeline_actor")
}

enum PurchaseVoucherSlot {
  PLATFORM      @map("platform")
  SHOP          @map("shop")
  FREE_SHIPPING @map("free_shipping")

  @@map("purchase_voucher_slot")
}

enum VoucherAllocationKind {
  MERCHANDISE @map("merchandise")
  SHIPPING    @map("shipping")

  @@map("voucher_allocation_kind")
}

enum ReviewVisibility {
  VISIBLE @map("visible")
  HIDDEN  @map("hidden")

  @@map("review_visibility")
}

enum ReviewMediaState {
  STAGED   @map("staged")
  ATTACHED @map("attached")

  @@map("review_media_state")
}

enum SellerProductMediaState {
  STAGED   @map("staged")
  ATTACHED @map("attached")

  @@map("seller_product_media_state")
}

enum InventoryAdjustmentReason {
  INITIAL_STOCK @map("initial_stock")
  PRODUCT_EDIT  @map("product_edit")
  RESTOCK       @map("restock")
  DAMAGE        @map("damage")
  RETURN        @map("return")
  CORRECTION    @map("correction")
  ORDER_CANCELLATION @map("order_cancellation")

  @@map("inventory_adjustment_reason")
}

enum InventoryReservationStatus {
  ACTIVE   @map("active")
  CONSUMED @map("consumed")
  RELEASED @map("released")
  EXPIRED  @map("expired")

  @@map("inventory_reservation_status")
}

enum SellerOrderFulfillmentState {
  PENDING_CONFIRMATION @map("pending_confirmation")
  CONFIRMED            @map("confirmed")
  PREPARING            @map("preparing")
  READY_FOR_PICKUP     @map("ready_for_pickup")
  HANDED_OFF           @map("handed_off")
  REJECTED             @map("rejected")
  CANCELLED            @map("cancelled")

  @@map("seller_order_fulfillment_state")
}

enum SellerOrderShipmentProvider {
  MOCK @map("mock")

  @@map("seller_order_shipment_provider")
}

enum SellerOrderShipmentStatus {
  HANDED_OFF @map("handed_off")

  @@map("seller_order_shipment_status")
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique @db.VarChar(320)
  displayName              String                    @map("display_name") @db.VarChar(120)
  phoneNumber              String?                   @map("phone_number") @db.VarChar(10)
  passwordHash             String?                   @map("password_hash") @db.VarChar(255)
  status                   UserStatus                @default(ACTIVE)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  shops                    Shop[]
  authSessions             AuthSession[]
  passwordResetTokens      PasswordResetToken[]
  externalIdentities       ExternalIdentity[]
  roleAssignments          UserRoleAssignment[]      @relation("RoleAssignmentTarget")
  rolesGranted             UserRoleAssignment[]      @relation("RoleAssignmentActor")
  roleAuditEvents          RoleAuditEvent[]          @relation("RoleAuditTarget")
  roleAuditActions         RoleAuditEvent[]          @relation("RoleAuditActor")
  shippingAddresses        ShippingAddress[]
  productFavorites         ProductFavorite[]
  recentlyViewed           RecentlyViewedProduct[]
  followedShops            ShopFollower[]
  cart                     Cart?
  voucherUsages            VoucherUserUsage[]
  voucherConsumptions      VoucherConsumption[]
  voucherRedemptions       VoucherRedemption[]
  purchases                Purchase[]
  orderTimelineEvents      OrderTimelineEvent[]      @relation("OrderTimelineActorUser")
  sellerFulfillmentEvents  SellerOrderFulfillmentEvent[] @relation("SellerOrderFulfillmentActorUser")
  sellerCompensations      SellerOrderInventoryCompensation[] @relation("SellerOrderCompensationActor")
  productReviews           ProductReview[]           @relation("ReviewBuyer")
  stagedReviewMedia        ReviewMedia[]             @relation("ReviewMediaUploader")
  stagedSellerProductMedia SellerProductMediaAsset[] @relation("SellerProductMediaUploader")
  reviewModeration         ReviewModerationEvent[]   @relation("ReviewModerationActor")
  inventoryAdjustments     InventoryAdjustment[]     @relation("InventoryAdjustmentActor")
  inventoryReservations    InventoryReservation[]    @relation("InventoryReservationBuyer")
  privilegedAuditActions   PrivilegedAuditEvent[]    @relation("PrivilegedAuditActor")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model ShippingAddress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(120)
  phoneNumber   String    @map("phone_number") @db.VarChar(10)
  province      String    @db.VarChar(100)
  district      String    @db.VarChar(100)
  ward          String    @db.VarChar(100)
  addressLine   String    @map("address_line") @db.VarChar(255)
  label         String?   @db.VarChar(50)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, isDefault, createdAt, id])
  @@index([deletedAt])
  @@map("shipping_addresses")
}

model UserRoleAssignment {
  userId          String          @map("user_id") @db.Uuid
  role            MarketplaceRole
  grantedAt       DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  source          RoleAuditSource
  grantedByUserId String?         @map("granted_by_user_id") @db.Uuid
  user            User            @relation("RoleAssignmentTarget", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy       User?           @relation("RoleAssignmentActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@index([role, userId])
  @@index([grantedByUserId])
  @@map("user_role_assignments")
}

model RoleAuditEvent {
  id           String          @id @default(uuid()) @db.Uuid
  targetUserId String          @map("target_user_id") @db.Uuid
  role         MarketplaceRole
  action       RoleAuditAction
  source       RoleAuditSource
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  reason       String          @db.VarChar(240)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  targetUser   User            @relation("RoleAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUser    User?           @relation("RoleAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([role, action, createdAt])
  @@map("role_audit_events")
}

model PrivilegedAuditEvent {
  id            String               @id @default(uuid()) @db.Uuid
  actorUserId   String               @map("actor_user_id") @db.Uuid
  targetType    PrivilegedTargetType @map("target_type")
  targetId      String               @map("target_id") @db.Uuid
  action        PrivilegedAction
  reason        String               @db.VarChar(240)
  beforeSummary Json?                @map("before_summary")
  afterSummary  Json?                @map("after_summary")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser     User                 @relation("PrivilegedAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("privileged_audit_events")
}


model ExternalIdentity {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  provider        ExternalIdentityProvider
  providerSubject String                   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt     DateTime                 @default(now()) @map("last_login_at") @db.Timestamptz(3)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([provider, userId])
  @@index([userId])
  @@map("external_identities")
}

model GoogleLoginAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  stateHash          String    @unique @map("state_hash") @db.Char(64)
  browserBindingHash String    @map("browser_binding_hash") @db.Char(64)
  nonceHash          String    @map("nonce_hash") @db.Char(64)
  protectedPayload   String    @map("protected_payload") @db.Text
  returnTo           String    @map("return_to") @db.VarChar(500)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([consumedAt, expiresAt])
  @@map("google_login_attempts")
}

model AuthSession {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  familyId     String       @default(uuid()) @map("family_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)
  rotatedAt    DateTime?    @map("rotated_at") @db.Timestamptz(3)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  replacedById String?      @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(3)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   AuthSession? @relation("AuthSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id             String                      @id @default(uuid()) @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  tokenHash      String                      @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime                    @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?                   @map("used_at") @db.Timestamptz(3)
  revokedAt      DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  deliveryStatus PasswordResetDeliveryStatus @default(PENDING) @map("delivery_status")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Shop {
  id                       String                    @id @default(uuid()) @db.Uuid
  ownerId                  String                    @map("owner_id") @db.Uuid
  slug                     String                    @unique @db.VarChar(120)
  name                     String                    @db.VarChar(160)
  description              String                    @default("") @db.VarChar(2000)
  logoUrl                  String?                   @map("logo_url") @db.VarChar(500)
  bannerUrl                String?                   @map("banner_url") @db.VarChar(500)
  location                 String                    @default("Việt Nam") @db.VarChar(120)
  timeZone                 String                    @default("Asia/Ho_Chi_Minh") @map("time_zone") @db.VarChar(64)
  contactPhone             String?                   @map("contact_phone") @db.VarChar(10)
  contactEmail             String?                   @map("contact_email") @db.VarChar(320)
  pickupRecipientName      String?                   @map("pickup_recipient_name") @db.VarChar(120)
  pickupPhoneNumber        String?                   @map("pickup_phone_number") @db.VarChar(10)
  pickupProvince           String?                   @map("pickup_province") @db.VarChar(100)
  pickupDistrict           String?                   @map("pickup_district") @db.VarChar(100)
  pickupWard               String?                   @map("pickup_ward") @db.VarChar(100)
  pickupAddressLine        String?                   @map("pickup_address_line") @db.VarChar(255)
  returnRecipientName      String?                   @map("return_recipient_name") @db.VarChar(120)
  returnPhoneNumber        String?                   @map("return_phone_number") @db.VarChar(10)
  returnProvince           String?                   @map("return_province") @db.VarChar(100)
  returnDistrict           String?                   @map("return_district") @db.VarChar(100)
  returnWard               String?                   @map("return_ward") @db.VarChar(100)
  returnAddressLine        String?                   @map("return_address_line") @db.VarChar(255)
  status                   ShopStatus                @default(INACTIVE)
  onboardingStatus         ShopOnboardingStatus      @default(PENDING_APPROVAL) @map("onboarding_status")
  onboardingReason         String?                   @map("onboarding_reason") @db.VarChar(240)
  ratingAverageBasisPoints Int                       @default(0) @map("rating_average_basis_points")
  ratingCount              Int                       @default(0) @map("rating_count")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  owner                    User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products                 Product[]
  followers                ShopFollower[]
  vouchers                 Voucher[]
  discountCampaigns        ShopDiscountCampaign[]
  sellerPromotionCommands  SellerPromotionCommand[]
  orders                   ShopOrder[]
  purchaseVouchers         PurchaseVoucher[]
  reviews                  ProductReview[]
  productMediaAssets       SellerProductMediaAsset[]
  inventoryAdjustments     InventoryAdjustment[]

  @@index([ownerId])
  @@index([status])
  @@index([onboardingStatus])
  @@index([deletedAt])
  @@map("shops")
}

model Category {
  id                   String                        @id @default(uuid()) @db.Uuid
  parentId             String?                       @map("parent_id") @db.Uuid
  slug                 String                        @unique @db.VarChar(120)
  name                 String                        @db.VarChar(160)
  sortOrder            Int                           @default(0) @map("sort_order")
  isActive             Boolean                       @default(true) @map("is_active")
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                     @map("deleted_at") @db.Timestamptz(3)
  parent               Category?                     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Category[]                    @relation("CategoryHierarchy")
  products             Product[]
  attributeDefinitions CategoryAttributeDefinition[]
  homepageEntries      HomepageModuleCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id                       String                    @id @default(uuid()) @db.Uuid
  shopId                   String                    @map("shop_id") @db.Uuid
  categoryId               String                    @map("category_id") @db.Uuid
  slug                     String                    @db.VarChar(160)
  name                     String                    @db.VarChar(240)
  description              String                    @db.Text
  status                   ProductStatus             @default(DRAFT)
  moderationStatus         ProductModerationStatus   @default(ACTIVE) @map("moderation_status")
  packageLengthMm          Int?                      @map("package_length_mm")
  packageWidthMm           Int?                      @map("package_width_mm")
  packageHeightMm          Int?                      @map("package_height_mm")
  ratingAverageBasisPoints Int                       @default(0) @map("rating_average_basis_points")
  ratingCount              Int                       @default(0) @map("rating_count")
  soldCount                Int                       @default(0) @map("sold_count")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  purgeBlockedAt           DateTime?                 @map("purge_blocked_at") @db.Timestamptz(3)
  purgeBlockReason         String?                   @map("purge_block_reason") @db.VarChar(80)
  shop                     Shop                      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category                 Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants                 ProductVariant[]
  images                   ProductImage[]
  homepageEntries          HomepageModuleProduct[]
  datasetRecord            DatasetProductRecord?
  favorites                ProductFavorite[]
  recentlyViewedBy         RecentlyViewedProduct[]
  voucherScopes            VoucherProductScope[]
  discountCampaignProducts ShopDiscountProduct[]
  orderLines               OrderLine[]
  reviews                  ProductReview[]
  attributes               ProductAttributeValue[]
  optionGroups             ProductOptionGroup[]
  mediaAssets              SellerProductMediaAsset[]

  @@unique([shopId, slug])
  @@index([shopId, status])
  @@index([status, moderationStatus])
  @@index([categoryId, status])
  @@index([status, createdAt, id])
  @@index([deletedAt])
  @@index([deletedAt, purgeBlockedAt, id])
  @@map("products")
}

model ProductFavorite {
  userId      String   @map("user_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  favoritedAt DateTime @default(now()) @map("favorited_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, favoritedAt(sort: Desc), productId])
  @@index([productId])
  @@map("product_favorites")
}

model RecentlyViewedProduct {
  userId       String   @map("user_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  lastViewedAt DateTime @default(now()) @map("last_viewed_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, lastViewedAt(sort: Desc), productId])
  @@index([productId])
  @@map("recently_viewed_products")
}

model ShopFollower {
  userId     String   @map("user_id") @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  followedAt DateTime @default(now()) @map("followed_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([shopId, followedAt(sort: Desc), userId])
  @@index([userId, followedAt(sort: Desc), shopId])
  @@map("shop_followers")
}

model DatasetSource {
  id            String                 @id @db.Uuid
  key           String                 @unique @db.VarChar(64)
  fileName      String                 @unique @map("file_name") @db.VarChar(120)
  sourceUrl     String                 @map("source_url") @db.Text
  checksum      String                 @db.Char(64)
  recordCount   Int                    @map("record_count")
  rootMetadata  Json                   @map("root_metadata") @db.JsonB
  policyVersion String                 @map("policy_version") @db.VarChar(40)
  importedAt    DateTime               @map("imported_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  records       DatasetProductRecord[]

  @@index([policyVersion])
  @@map("dataset_sources")
}

model DatasetProductRecord {
  id               String        @id @db.Uuid
  sourceId         String        @map("source_id") @db.Uuid
  productId        String        @unique @map("product_id") @db.Uuid
  stableRecordKey  String        @map("stable_record_key") @db.Char(64)
