# Local development only. Replace these values in the ignored .env file.
# Never reuse these placeholders for staging, production, or shared databases.
POSTGRES_USER=shopee_local
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=shopee_clone
POSTGRES_TEST_DB=shopee_clone_test
POSTGRES_PORT=5432
SHOPEE_COMPOSE_SCOPE=development
DEV_ENV_FILE=.env.example
NODE_ENV=development

DATABASE_URL=postgresql://shopee_local:local_only_change_me@127.0.0.1:5432/shopee_clone
TEST_DATABASE_URL=postgresql://shopee_local:local_only_change_me@127.0.0.1:5432/shopee_clone_test
PORT=3001
HOMEPAGE_API_BASE_URL=http://localhost:3001

# T34 optional local product search. Keep all feature flags disabled until the
# projection and ranking paths have been bootstrapped and verified.
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_PRODUCT_INDEX_ALIAS=products-search
ELASTICSEARCH_REQUEST_TIMEOUT_MS=150
ELASTICSEARCH_INDEXING_REQUEST_TIMEOUT_MS=30000
ELASTICSEARCH_INDEX_FRESHNESS_TARGET_SECONDS=30
ELASTICSEARCH_INCREMENTAL_BATCH_SIZE=250
ELASTICSEARCH_PERIODIC_RECONCILIATION_WINDOW_SECONDS=3600
SEARCH_ELASTICSEARCH_ENABLED=false
SEARCH_PERSONALIZATION_ENABLED=false
SEARCH_DAILY_RECOMMENDATIONS_ENABLED=false

# Authentication values below are local placeholders only.
AUTH_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes_for_shared_environments
AUTH_LIMITER_SECRET=replace_with_a_different_32_byte_random_value
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_WEB_BASE_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_RECOVERY_MODE=file
# Test runners may set AUTH_RECOVERY_CAPTURE_PATH to a temporary, deleted JSONL file.
AUTH_RECOVERY_OUTBOX_DIR=.runtime/mail-outbox
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/login/oauth2/code/google
RBAC_BOOTSTRAP_ADMIN_EMAIL=
RBAC_BOOTSTRAP_REASON=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# T33 local Demo Carrier (simulation only; no real courier credentials).
DEMO_CARRIER_ENABLED=true
BUYER_BEST_PRICE_PREVIEW_ENABLED=false
BUYER_BEST_PRICE_MAX_CANDIDATES_PER_SLOT=8
BUYER_BEST_PRICE_MAX_COMBINATIONS=256
DEMO_CARRIER_URL=http://localhost:3010
DEMO_CARRIER_PORT=3010
DEMO_CARRIER_DATABASE_URL=postgresql://shopee_local:local_only_change_me@127.0.0.1:5433/shopee_clone_demo_carrier
DEMO_CARRIER_HMAC_ACTIVE_KEY_ID=local-demo-carrier-v1
DEMO_CARRIER_HMAC_ACTIVE_SECRET=replace-with-a-local-only-demo-carrier-secret
DEMO_CARRIER_HMAC_PREVIOUS_KEY_ID=
DEMO_CARRIER_HMAC_PREVIOUS_SECRET=

# MoMo M4B sandbox only. Obtain credentials from the MoMo Business sandbox portal.
MOMO_ENABLED=false
MOMO_ENV=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_IPN_URL=https://replace-with-public-tunnel.example/api/v1/payment-providers/momo/ipn
MOMO_REDIRECT_URL=https://replace-with-public-web.example/checkout/payment/result
MOMO_HTTP_TIMEOUT_MS=30000
MOMO_PAYMENT_TTL_SECONDS=600
VNPAY_ENABLED=false
VNPAY_ENV=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/callback
VNPAY_IPN_URL=https://replace-with-public-tunnel.example/api/v1/payment-providers/vnpay/ipn
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_HTTP_TIMEOUT_MS=30000
VNPAY_PAYMENT_TTL_SECONDS=600

# Floating user-to-user text chat runtime limits.
CHAT_TICKET_TTL_SECONDS=60
CHAT_PRESENCE_LEASE_SECONDS=45
CHAT_OUTBOX_BATCH=50
CHAT_MESSAGE_RATE_PER_MINUTE=30
CHAT_RATE_LIMIT_HMAC_SECRET=replace-with-a-long-random-secret

# Seller product images use a private S3 bucket when AWS_S3_BUCKET is configured.
# In staging/production prefer the EC2 instance/task role credential chain; the
# access-key variables are only for isolated local S3-compatible development.
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-1
AWS_S3_PREFIX=
# Public CloudFront viewer base used for attached product image URLs. S3 itself
# remains private; set this to the distribution that serves seller-product-media.
AWS_S3_PUBLIC_BASE_URL=https://cdn.videod.me
# Optional S3-compatible endpoint (for example, LocalStack or MinIO).
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_SELLER_PRODUCT_MEDIA_UPLOAD_ENABLED=true
AWS_S3_UPLOAD_URL_TTL_SECONDS=300

# Public CloudFront viewer URL. Keep the S3 origin private and grant CloudFront
# access through Origin Access Control (OAC).
AWS_CLOUDFRONT_BASE_URL=https://cdn.videod.me

# Filesystem fallback for local development/tests when AWS_S3_BUCKET is empty.
# With `pnpm dev`, the effective local path is apps/api/.runtime/seller-product-media.
SELLER_PRODUCT_MEDIA_ROOT=.runtime/seller-product-media
