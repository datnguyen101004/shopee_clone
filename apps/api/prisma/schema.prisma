model User {
  id                          String                             @id @default(uuid()) @db.Uuid
  email                       String                             @unique @db.VarChar(320)
  displayName                 String                             @map("display_name") @db.VarChar(120)
  phoneNumber                 String?                            @map("phone_number") @db.VarChar(10)
  passwordHash                String?                            @map("password_hash") @db.VarChar(255)
  status                      UserStatus                         @default(ACTIVE)
  createdAt                   DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                   DateTime?                          @map("deleted_at") @db.Timestamptz(3)
  shop                        Shop?
  authSessions                AuthSession[]
  passwordResetTokens         PasswordResetToken[]
  externalIdentities          ExternalIdentity[]
  roleAssignments             UserRoleAssignment[]               @relation("RoleAssignmentTarget")
  rolesGranted                UserRoleAssignment[]               @relation("RoleAssignmentActor")
  roleAuditEvents             RoleAuditEvent[]                   @relation("RoleAuditTarget")
  roleAuditActions            RoleAuditEvent[]                   @relation("RoleAuditActor")
  shippingAddresses           ShippingAddress[]
  productFavorites            ProductFavorite[]
  recentlyViewed              RecentlyViewedProduct[]
  followedShops               ShopFollower[]
  cart                        Cart?
  voucherUsages               VoucherUserUsage[]
  voucherConsumptions         VoucherConsumption[]
  voucherRedemptions          VoucherRedemption[]
  purchases                   Purchase[]
  orderTimelineEvents         OrderTimelineEvent[]               @relation("OrderTimelineActorUser")
  sellerFulfillmentEvents     SellerOrderFulfillmentEvent[]      @relation("SellerOrderFulfillmentActorUser")
  sellerCompensations         SellerOrderInventoryCompensation[] @relation("SellerOrderCompensationActor")
  productReviews              ProductReview[]                    @relation("ReviewBuyer")
  sellerReviewReports         SellerReviewReport[]               @relation("SellerReviewReporter")
  stagedReviewMedia           ReviewMedia[]                      @relation("ReviewMediaUploader")
  stagedSellerProductMedia    SellerProductMediaAsset[]          @relation("SellerProductMediaUploader")
  stagedHomepageBannerMedia   HomepageBannerMediaAsset[]         @relation("HomepageBannerMediaUploader")
  reviewModeration            ReviewModerationEvent[]            @relation("ReviewModerationActor")
  inventoryAdjustments        InventoryAdjustment[]              @relation("InventoryAdjustmentActor")
  inventoryReservations       InventoryReservation[]             @relation("InventoryReservationBuyer")
  privilegedAuditActions      PrivilegedAuditEvent[]             @relation("PrivilegedAuditActor")
  userReports                 UserReport[]                       @relation("UserReportsSubmitted")
  moderationAssignments       ModerationCase[]                   @relation("ModerationCaseAssignee")
  moderationCasesReported     ModerationCase[]                   @relation("ModerationCaseReportedUser")
  moderationCaseEvents        ModerationCaseEvent[]              @relation("ModerationCaseEventActor")
  moderationDecisions         ModerationDecision[]               @relation("ModerationDecisionActor")
  moderationCommands          ModerationCommand[]                @relation("ModerationCommandActor")
  reportRateLimitEvents       ReportRateLimitEvent[]             @relation("ReportRateLimitReporter")
  sellerModerationNotices     SellerModerationNotice[]           @relation("SellerModerationNoticeOwner")
  returnRequests              ReturnRequest[]                    @relation("ReturnRequestBuyer")
  returnEvents                ReturnEvent[]                      @relation("ReturnEventActor")
  stagedReturnEvidence        ReturnEvidenceAsset[]              @relation("ReturnEvidenceUploader")
  returnDecisions             ReturnDecision[]                   @relation("ReturnDecisionActor")
  refundLedgerEntries         RefundLedgerEntry[]                @relation("RefundLedgerBuyer")
  notifications               Notification[]                     @relation("NotificationRecipient")
  notificationPreferences     NotificationPreference[]           @relation("NotificationPreferenceOwner")
  chatConversationsLow        ChatConversation[]                 @relation("ChatConversationLowParticipant")
  chatConversationsHigh       ChatConversation[]                 @relation("ChatConversationHighParticipant")
  chatMemberships             ChatMembership[]                   @relation("ChatMembershipUser")
  chatMessagesSent            ChatMessage[]                      @relation("ChatMessageSender")
  chatOutboxRecipients        ChatOutbox[]                       @relation("ChatOutboxRecipient")
  chatBlocksCreated           ChatUserBlock[]                    @relation("ChatBlocker")
  chatBlocksReceived          ChatUserBlock[]                    @relation("ChatBlocked")
  chatRateLimitEvents         ChatRateLimitEvent[]               @relation("ChatRateSubject")
  chatAttentionLeases         ChatAttentionLease[]               @relation("ChatAttentionUser")
  chatRestriction             UserChatRestriction?               @relation("ChatRestrictionUser")
  buyerSearchProfile          BuyerSearchProfile?
  chatReportsTargeted         UserReport[]                       @relation("UserReportsTarget")
  marketplaceCampaignCommands MarketplaceCampaignCommand[]       @relation("MarketplaceCampaignCommandActor")
  marketplaceCampaignAudits   MarketplaceCampaignAudit[]         @relation("MarketplaceCampaignAuditActor")
  flashSaleBuyerClaims        FlashSaleBuyerClaim[]

  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model ShippingAddress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(120)
  phoneNumber   String    @map("phone_number") @db.VarChar(10)
  province      String    @db.VarChar(100)
  district      String    @db.VarChar(100)
  ward          String    @db.VarChar(100)
  addressLine   String    @map("address_line") @db.VarChar(255)
  label         String?   @db.VarChar(50)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, isDefault, createdAt, id])
  @@index([deletedAt])
  @@map("shipping_addresses")
}

model UserRoleAssignment {
  userId          String          @map("user_id") @db.Uuid
  role            MarketplaceRole
  grantedAt       DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  source          RoleAuditSource
  grantedByUserId String?         @map("granted_by_user_id") @db.Uuid
  user            User            @relation("RoleAssignmentTarget", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy       User?           @relation("RoleAssignmentActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@index([role, userId])
  @@index([grantedByUserId])
  @@map("user_role_assignments")
}

model RoleAuditEvent {
  id           String          @id @default(uuid()) @db.Uuid
  targetUserId String          @map("target_user_id") @db.Uuid
  role         MarketplaceRole
  action       RoleAuditAction
  source       RoleAuditSource
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  reason       String          @db.VarChar(240)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  targetUser   User            @relation("RoleAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUser    User?           @relation("RoleAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([role, action, createdAt])
  @@map("role_audit_events")
}

model PrivilegedAuditEvent {
  id                      String                 @id @default(uuid()) @db.Uuid
  actorUserId             String                 @map("actor_user_id") @db.Uuid
  targetType              PrivilegedTargetType   @map("target_type")
  targetId                String                 @map("target_id") @db.Uuid
  action                  PrivilegedAction
  reason                  String                 @db.VarChar(240)
  beforeSummary           Json?                  @map("before_summary")
  afterSummary            Json?                  @map("after_summary")
  decisionId              String?                @map("decision_id") @db.Uuid
  reviewModerationEventId String?                @map("review_moderation_event_id") @db.Uuid
  returnDecisionId        String?                @map("return_decision_id") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser               User                   @relation("PrivilegedAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  decision                ModerationDecision?    @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  reviewModerationEvent   ReviewModerationEvent? @relation(fields: [reviewModerationEventId], references: [id], onDelete: Restrict)
  returnDecision          ReturnDecision?        @relation(fields: [returnDecisionId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([targetType, targetId, createdAt])
