# Local development only. Replace these values in the ignored .env file.
# Never reuse these placeholders for staging, production, or shared databases.
POSTGRES_USER=shopee_local
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=shopee_clone
POSTGRES_TEST_DB=shopee_clone_test
POSTGRES_PORT=5432
SHOPEE_COMPOSE_SCOPE=development

DATABASE_URL=postgresql://shopee_local:local_only_change_me@127.0.0.1:5432/shopee_clone
TEST_DATABASE_URL=postgresql://shopee_local:local_only_change_me@127.0.0.1:5432/shopee_clone_test
PORT=3001
HOMEPAGE_API_BASE_URL=http://localhost:3001

# Authentication values below are local placeholders only.
AUTH_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes_for_shared_environments
AUTH_LIMITER_SECRET=replace_with_a_different_32_byte_random_value
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_WEB_BASE_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_RECOVERY_MODE=file
# Test runners may set AUTH_RECOVERY_CAPTURE_PATH to a temporary, deleted JSONL file.
AUTH_RECOVERY_OUTBOX_DIR=.runtime/mail-outbox
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/login/oauth2/code/google
RBAC_BOOTSTRAP_ADMIN_EMAIL=
RBAC_BOOTSTRAP_REASON=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Seller product images use S3 when AWS_S3_BUCKET is configured. The API reads
# these values only at runtime; never commit real credentials to this file.
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PREFIX=seller-product-media
# Optional S3-compatible endpoint (for example, LocalStack or MinIO).
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Filesystem fallback for local development/tests when AWS_S3_BUCKET is empty.
# With `pnpm dev`, the effective local path is apps/api/.runtime/seller-product-media.
SELLER_PRODUCT_MEDIA_ROOT=.runtime/seller-product-media
