{
  "name": "shopee-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@shopee-clone/web",
    "dev:api": "turbo run dev --filter=@shopee-clone/api",
    "infra:config": "docker compose config --quiet",
    "infra:config:example": "docker compose --env-file .env.example config --quiet",
    "infra:up": "docker compose up --detach --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs --follow --tail=100 postgres",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "infra:smoke": "node scripts/infrastructure-smoke.mjs",
    "ci:validate": "node scripts/validate-ci.mjs",
    "auth:google:preflight": "node --env-file=.env scripts/google-oauth-preflight.mjs",
    "auth:roles:bootstrap-admin": "pnpm --filter @shopee-clone/api auth:roles:bootstrap-admin",
    "db:generate": "pnpm --filter @shopee-clone/api db:generate",
    "db:format": "pnpm --filter @shopee-clone/api db:format",
    "db:validate": "pnpm --filter @shopee-clone/api db:validate",
    "db:migrate": "pnpm --filter @shopee-clone/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @shopee-clone/api db:migrate:deploy",
    "db:seed": "pnpm --filter @shopee-clone/api db:seed",
    "db:import:dataset": "pnpm --filter @shopee-clone/api db:import:dataset",
    "db:reset": "pnpm --filter @shopee-clone/api db:reset",
    "db:verify": "pnpm --filter @shopee-clone/api db:verify",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:infra && turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:homepage": "node scripts/homepage-e2e.mjs",
    "test:e2e:homepage:update": "node scripts/homepage-e2e.mjs --update-snapshots",
    "test:e2e:homepage:quick": "node scripts/quick-e2e.mjs homepage",
    "test:e2e:catalog": "node scripts/homepage-e2e.mjs catalog",
    "test:e2e:catalog:update": "node scripts/homepage-e2e.mjs catalog --update-snapshots",
    "test:e2e:catalog:quick": "node scripts/quick-e2e.mjs catalog",
    "test:e2e:product": "node scripts/homepage-e2e.mjs product",
    "test:e2e:product:update": "node scripts/homepage-e2e.mjs product --update-snapshots",
    "test:e2e:product:quick": "node scripts/quick-e2e.mjs product",
    "test:e2e:auth": "node scripts/homepage-e2e.mjs auth",
    "test:e2e:auth:update": "node scripts/homepage-e2e.mjs auth --update-snapshots",
    "test:e2e:auth:quick": "node scripts/quick-e2e.mjs auth",
    "test:e2e:account:quick": "node scripts/quick-e2e.mjs account",
    "test:infra": "node --test scripts/infrastructure-smoke.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
